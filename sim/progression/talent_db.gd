class_name TalentDB
extends RefCounted
## The talent tree from data/talents.json (generated by tools/data/make_talents.mjs, Plan
## 8.3g): seven closed rings round the start; nodes with kind, direction (dir, and mix for
## the blended ones), ring (0 the start, 1..7), position (x, y inside the unit circle),
## icon, stat modifiers and links; and the recommended route of each class.

const PATH := "res://data/talents.json"

static var _default: TalentDB

var _start: String = "start"
var _directions: Array = []
var _nodes: Dictionary = {}
var _routes: Dictionary = {}


static func load_default() -> TalentDB:
	if _default == null:
		_default = from_dict(JSON.parse_string(FileAccess.get_file_as_string(PATH)))
	return _default


static func from_dict(d: Variant) -> TalentDB:
	var db := TalentDB.new()
	if d is Dictionary:
		db._start = str(d.get("start", "start"))
		db._directions = d.get("directions", [])
		db._nodes = d.get("nodes", {})
		db._routes = d.get("routes", {}) if d.get("routes") is Dictionary else {}
	return db


func start_id() -> String:
	return _start


## The five pure directions.
func directions() -> Array:
	return _directions


func has(id: String) -> bool:
	return _nodes.has(id)


func node(id: String) -> Dictionary:
	return _nodes.get(id, {})


func ids() -> Array:
	return _nodes.keys()


## The recommended route of a class: node ids in buying order ([] for an unknown class).
func route(class_id: String) -> Array:
	return (_routes.get(class_id, []) as Array).duplicate()


## How many rings the tree has (the start is ring 0).
func rings() -> int:
	var n := 0
	for id: String in _nodes:
		n = maxi(n, int(_nodes[id].get("ring", 0)))
	return n


## Number of nodes in a ring.
func count(ring: int) -> int:
	var n := 0
	for id: String in _nodes:
		if int(_nodes[id].get("ring", 1)) == ring:
			n += 1
	return n
